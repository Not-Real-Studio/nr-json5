{
  "name": "@notrealstudio/nr-json5",
  "version": "0.1.0",
  "description": "JSON5 microcodec: full reader (json5-tests green), canonical single-line relaxed writer. Zero dependencies.",
  "keywords": [
    "json5",
    "json",
    "parser",
    "serializer",
    "stringify",
    "zero-dependency",
    "canonical"
  ],
  "license": "MIT",
  "author": "Julian Garrett",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Not-Real-Studio/nr-json5.git"
  },
  "homepage": "https://github.com/Not-Real-Studio/nr-json5#readme",
  "bugs": {
    "url": "https://github.com/Not-Real-Studio/nr-json5/issues"
  }
}
